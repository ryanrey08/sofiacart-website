NEXT_PUBLIC_APP_NAME=SofiaCart
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001/api
NEXT_PUBLIC_ENABLE_API_MOCKS=false

# Store subdomains: <store>.NEXT_PUBLIC_STORE_ROOT_DOMAIN is that store's storefront.
# Production: sofiacart.ph (chemkleen.sofiacart.ph). Local: localhost (chemkleen.localhost:3001).
NEXT_PUBLIC_STORE_ROOT_DOMAIN=localhost
# Optional: the customer API address the Next server uses to load the store (e.g. a private network URL).
# API_INTERNAL_BASE_URL=http://sofiacart-website-web/api
# Optional: where "Go to SofiaCart" on a store-not-found page links (the merchant platform), e.g. https://sofiacart.ph
# NEXT_PUBLIC_PLATFORM_URL=https://sofiacart.ph
